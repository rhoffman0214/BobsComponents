@* Parameters, events and slots, all generated by reflecting over [Parameter] and joining the XML documentation. *@
@foreach (var group in Groups())
{
    <h3 class="bobdoc-h3">@group.Title</h3>
    <p class="bobdoc-muted">@group.Help</p>
    <div class="bobdoc-tablewrap">
        <table class="bobdoc-table">
            <caption class="bobdoc-visually-hidden">@group.Title of @Api.Name</caption>
            <thead>
                <tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Default</th><th scope="col">What it does</th></tr>
            </thead>
            <tbody>
                @foreach (var p in group.Items)
                {
                    <tr id="@DocIds.Param(p.Name)">
                        <th scope="row">
                            <code>@p.Name</code>
                            @if (p.Required)
                            {
                                <span class="bobdoc-required">required</span>
                            }
                            @if (p.Inherited)
                            {
                                <span class="bobdoc-muted"> from @p.DeclaredIn</span>
                            }
                        </th>
                        <td><code>@p.Type</code></td>
                        <td><code>@p.Default</code></td>
                        <td>
                            @if (string.IsNullOrEmpty(p.Summary))
                            {
                                <span class="bobdoc-missing">No XML doc comment.</span>
                            }
                            else
                            {
                                <DocText Text="@p.Summary" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!Api.Parameters.Any())
{
    <p>This component takes no parameters.</p>
}

@code {
    [Parameter, EditorRequired] public ComponentApi Api { get; set; } = default!;

    private IEnumerable<(string Title, string Help, IEnumerable<ParameterDoc> Items)> Groups()
    {
        var all = new[]
        {
            ("Parameters", "Values you pass in.", ApiKind.Parameter),
            ("Events", "Callbacks the component invokes. A handler that throws becomes a callback error card.", ApiKind.Event),
            ("Slots", "Content you provide (render fragments).", ApiKind.Slot),
            ("Cascading values", "Values the component reads from an ancestor.", ApiKind.Cascading),
            ("Extra attributes", "Anything else you write on the tag is passed to the root element.", ApiKind.Attributes),
        };
        foreach (var (title, help, kind) in all)
        {
            var items = Api.Of(kind).ToList();
            if (items.Count > 0) yield return (title, help, items);
        }
    }
}
