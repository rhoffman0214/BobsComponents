@* Points are placed by date. With fewer than two points the empty text shows instead. *@
<div style="display: flex; flex-direction: column; gap: 1rem;">
    <ProgressChart Label="Body weight, kg" Points="_weights" />
    <ProgressChart Label="Nothing logged yet" Points="_none" />
</div>

@code {
    private static readonly DateTimeOffset Start = new(2026, 9, 1, 0, 0, 0, TimeSpan.Zero);

    private readonly BobChartPoint[] _weights =
    [
        new(Start, 82.4), new(Start.AddDays(7), 81.9), new(Start.AddDays(14), 82.1),
        new(Start.AddDays(28), 80.6), new(Start.AddDays(42), 80.2),
    ];

    private readonly BobChartPoint[] _none = [new(Start, 1)];
}
