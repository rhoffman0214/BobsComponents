@* Placeholders keep the layout steady while data loads. The group is announced once as "Loading…"; the shapes are silent. *@
<div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <SkeletonLoader Shape="BobSkeletonShape.Circle" Height="3rem" Label="Loading avatar" />
        <div style="flex: 1;">
            <SkeletonLoader Count="3" Height="1rem" Label="Loading profile" />
        </div>
    </div>

    <SkeletonLoader Width="60%" Height="6rem" Radius="1rem" Label="Loading image" />

    @* Switch between the placeholder and the real content once the data arrives. *@
    <div>
        @if (_loading)
        {
            <SkeletonLoader Count="2" Height="1rem" Label="Loading message" />
        }
        else
        {
            <p style="margin: 0;">Loaded. Both lines of text arrived.</p>
        }
        <button type="button" class="bob-button" style="margin-top: 0.75rem;" @onclick="() => _loading = !_loading">
            @(_loading ? "Finish loading" : "Load again")
        </button>
    </div>
</div>

@code {
    private bool _loading = true;
}
