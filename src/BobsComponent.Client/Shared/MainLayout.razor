@using BobsComponent.Library
@using BobsComponent.Library.Components
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <VersionBadge />
            <ThemePicker />
        </div>

        <article class="content">
            @* Keyed by URL so a failed page recovers when you navigate away. *@
            <BobsComponents.Errors.BobErrorBoundary @key="Navigation.Uri" ComponentName="Page">
                @Body
            </BobsComponents.Errors.BobErrorBoundary>
        </article>
    </main>
</div>

<BobsComponents.Components.ToastHost />
<BobsComponents.Components.BobDevKit />