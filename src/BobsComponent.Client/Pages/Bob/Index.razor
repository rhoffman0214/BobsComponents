@page "/bob"

<PageTitle>Bob components - BobsComponents</PageTitle>

<div class="bobdoc-page">
    <header class="bobdoc-header">
        <h1>Bob components</h1>
        <p class="bobdoc-lead">
            The prefixed, layered component set. Every class, custom property and part attribute starts with <code>bob-</code>,
            the CSS lives in <code>@@layer bob</code>, and every failure becomes an error card that shows the exact cause.
            Component pages are generated from the code, so parameters, CSS and the DOM map cannot drift.
        </p>
        <SearchBox />
    </header>

    <section class="bobdoc-section" aria-labelledby="core-h">
        <h2 id="core-h">Core</h2>
        <ul>
            <li><a href="bob/errors">Error model</a> - six origins, one card</li>
            <li><a href="bob/error-catalog">Error catalog</a> - every code, cause and fix</li>
            <li><a href="bob/dev-kit">Dev kit</a> - errors, network, interop and DI panels</li>
            <li><a href="bob/changelog">Changelog</a> - breaking changes first</li>
            <li><a href="bob/search">Search</a> - components, parts, classes, variables and effects</li>
        </ul>
    </section>

    <section class="bobdoc-section" aria-labelledby="components-h">
        <h2 id="components-h">Components</h2>
        <ul>
            @foreach (var doc in DocRegistry.Components)
            {
                <li><a href="@doc.Href">@doc.Title</a> - <DocText Text="@DocRegistry.Model(doc).Api.Summary" /></li>
            }
        </ul>
    </section>
</div>
