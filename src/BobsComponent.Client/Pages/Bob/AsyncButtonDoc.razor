@page "/bob/async-button"

<ComponentDocPage Title="AsyncButton"
                  Lead="A button for any action the user has to wait on. It disables itself and shows a spinner while Busy, so a double click cannot fire twice."
                  UsageCode="@Usage" CssFile="_content/BobsComponents/css/components/button.css" CssExample="@CssExample"
                  Parameters="@_params" Parts="@_parts" Variables="@_vars" Accessibility="@_a11y" Errors="@_errors">
    <Demo>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <AsyncButton Variant="BobButtonVariant.Primary" Busy="_saving" BusyLabel="Saving…" OnClick="Save">Save</AsyncButton>
            <AsyncButton Variant="BobButtonVariant.Danger" Busy="_deleting" BusyLabel="Deleting…" OnClick="Delete">Delete</AsyncButton>
            <AsyncButton Variant="BobButtonVariant.Default" Disabled="true">Disabled</AsyncButton>
            <AsyncButton Variant="BobButtonVariant.Primary" Busy="true" BusyLabel="Always busy">Busy</AsyncButton>
        </div>
        <p role="status">@_message</p>
    </Demo>
</ComponentDocPage>

@code {
    private bool _saving;
    private bool _deleting;
    private string _message = "Click a button. Busy is owned by your code; here each action takes two seconds.";

    private async Task Save()
    {
        _saving = true;
        await Task.Delay(2000);
        _saving = false;
        _message = "Saved.";
    }

    private async Task Delete()
    {
        _deleting = true;
        await Task.Delay(2000);
        _deleting = false;
        _message = "Deleted.";
    }

    private const string Usage = """
        <AsyncButton Variant="BobButtonVariant.Primary" Busy="@_saving" BusyLabel="Saving…" OnClick="Save">
            Save
        </AsyncButton>

        @code {
            private bool _saving;
            private async Task Save()
            {
                _saving = true;
                await api.SaveAsync();   // an exception here surfaces as a "Your callback threw" error card
                _saving = false;
            }
        }
        """;

    private const string CssExample = """
        /* Leave Variant unset and use your own classes, or tune the built-in look: */
        .toolbar { --bob-button-radius: 999px; --bob-button-min-height: 2.25rem; }
        .bob-async-button[aria-busy="true"] { cursor: progress; }
        """;

    private static readonly DocParam[] _params =
    [
        new("Type", "string", "\"button\"", "HTML button type: button, submit or reset."),
        new("Variant", "BobButtonVariant?", "null", "Built-in look (Default, Primary, Danger). Null applies no colors so your own classes style the button."),
        new("CssClass", "string?", "null", "Extra classes on the button."),
        new("Busy", "bool", "false", "True while the action runs: disables the button and shows the spinner. The caller owns this state."),
        new("Disabled", "bool", "false", "Disables the button."),
        new("SpinnerSize", "int", "16", "Spinner size in pixels while busy, 1 to 512."),
        new("BusyLabel", "string", "\"Working…\"", "Announced to screen readers while busy."),
        new("OnClick", "EventCallback", "none", "Called on click. An exception it throws becomes a Your-callback-threw error."),
        new("StopPropagation", "bool", "false", "Stop the click from reaching parent elements."),
        new("ChildContent", "RenderFragment?", "null", "Button content shown when not busy."),
        new("AdditionalAttributes", "Dictionary<string, object>?", "null", "Any other attribute (aria-label, data-*) is placed on the button."),
    ];

    private static readonly DocPart[] _parts =
    [
        new("root", "bob-async-button", "button; with a Variant also bob-button and bob-button--{variant}"),
    ];

    private static readonly DocVar[] _vars =
    [
        new("--bob-button-bg", "var(--bob-color-surface)", "Background (when Variant is set)"),
        new("--bob-button-fg", "var(--bob-color-text)", "Text color"),
        new("--bob-button-border", "var(--bob-color-border)", "Border color"),
        new("--bob-button-radius", "var(--bob-radius-md)", "Corner radius"),
        new("--bob-button-padding", "0.5rem 1rem", "Inner spacing"),
        new("--bob-button-min-height", "2.75rem", "Minimum height (44px touch target)"),
        new("--bob-button-gap", "0.5rem", "Space between icon and text"),
    ];

    private static readonly string[] _a11y =
    [
        "Busy sets disabled and aria-busy=\"true\"; the spinner announces BusyLabel through its polite status region (WCAG 4.1.3).",
        "A native button: Enter and Space work, and the default minimum height is 44px.",
        "Known gap: a disabled button drops keyboard focus while busy. Callers that need to keep focus should move it deliberately when the action finishes.",
        "Icon-only content needs an aria-label, passed through AdditionalAttributes.",
    ];

    private static readonly DocError[] _errors =
    [
        new("BOB-PARAM-002", "when Type is not button, submit or reset, or SpinnerSize is outside 1 to 512."),
        new("BOB-CB-001", "when your OnClick handler throws."),
    ];
}
