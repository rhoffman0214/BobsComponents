@page "/bob/loading-spinner"

<ComponentDocPage Title="LoadingSpinner"
                  Lead="One waiting indicator that looks and sounds the same everywhere."
                  UsageCode="@Usage" CssFile="_content/BobsComponents/css/components/spinner.css" CssExample="@CssExample"
                  Parameters="@_params" Parts="@_parts" Variables="@_vars" Accessibility="@_a11y" Errors="@_errors">
    <Demo>
        <LoadingSpinner />
        <LoadingSpinner Label="Saving your changes…" Size="28" />
        <LoadingSpinner ShowLabel="false" Label="Hidden label, still announced" />
        <span style="--bob-spinner-color: var(--bob-color-danger); --bob-spinner-speed: 2s;">
            <LoadingSpinner Label="Recolored and slowed with custom properties" />
        </span>
    </Demo>
</ComponentDocPage>

@code {
    private const string Usage = """
        <LoadingSpinner />
        <LoadingSpinner Label="Saving…" Size="28" />
        <LoadingSpinner ShowLabel="false" Label="Loading results" />
        """;

    private const string CssExample = """
        /* your own CSS, outside any layer */
        .results { --bob-spinner-color: tomato; --bob-spinner-speed: 1.2s; }
        .results [data-bob-part="label"] { font-style: italic; }
        """;

    private static readonly DocParam[] _params =
    [
        new("Label", "string", "\"Loading…\"", "Text announced to screen readers, and shown when ShowLabel is true. Must not be empty."),
        new("ShowLabel", "bool", "true", "Show the label next to the icon. When false it is visually hidden but still announced."),
        new("Size", "int", "18", "Icon width and height in pixels, 1 to 512."),
        new("CssClass", "string?", "null", "Extra classes on the root element."),
        new("AdditionalAttributes", "Dictionary<string, object>?", "null", "Any other attribute is placed on the root element."),
    ];

    private static readonly DocPart[] _parts =
    [
        new("root", "bob-spinner", "span, role=status"),
        new("icon", "bob-spinner__icon", "svg, aria-hidden"),
        new("label", "bob-spinner__label", "span; adds bob-visually-hidden when ShowLabel is false"),
    ];

    private static readonly DocVar[] _vars =
    [
        new("--bob-spinner-color", "currentColor", "Icon color"),
        new("--bob-spinner-gap", "0.5rem", "Space between icon and label"),
        new("--bob-spinner-speed", "0.8s", "Time for one rotation"),
    ];

    private static readonly string[] _a11y =
    [
        "The root is role=\"status\" with aria-live=\"polite\", so a wait is announced without moving focus (WCAG 4.1.3).",
        "The spinning icon is aria-hidden; the label text is the one thing a screen reader announces, so it never reads SVG coordinates.",
        "With ShowLabel=false the label stays in the DOM, visually hidden, so the announcement still happens.",
        "The spin stops under prefers-reduced-motion (one shared rule in base.css); the text still appears.",
    ];

    private static readonly DocError[] _errors =
    [
        new("BOB-PARAM-002", "when Size is outside 1 to 512."),
        new("BOB-PARAM-001", "when Label is empty."),
    ];
}
