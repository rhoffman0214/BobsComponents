@page "/bob/modal-sheet"

<ComponentDocPage Title="ModalSheet"
                  Lead="Backdrop, sheet and header for dialogs: a bottom sheet on phones, a centered dialog from 640px. Owns focus trapping and the browser back button."
                  UsageCode="@Usage" CssFile="_content/BobsComponents/css/components/modal.css" CssExample="@CssExample"
                  Parameters="@_params" Parts="@_parts" Variables="@_vars" Accessibility="@_a11y" Errors="@_errors">
    <Demo>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <button type="button" class="bob-button bob-button--primary" @onclick="() => _first = true">Open a sheet</button>
        </div>
        <p role="status">@_status</p>

        <ModalSheet Show="_first" Title="Edit item" ShowHandle="true" OnClose="CloseFirst">
            <label for="demo-name">Name</label>
            <input id="demo-name" autofocus value="Squat" style="min-height: 2.75rem;" />
            <p>Tab and Shift+Tab stay inside. Escape, the backdrop, the close button and the browser back button all close it.</p>
            <button type="button" class="bob-button" @onclick="() => _second = true">Open a second sheet on top</button>
        </ModalSheet>

        <ModalSheet Show="_second" Title="Layered sheet" OnClose="() => _second = false">
            <p>Each open sheet keeps its own focus trap and returns focus to what opened it.</p>
        </ModalSheet>
    </Demo>
</ComponentDocPage>

@code {
    private bool _first;
    private bool _second;
    private string _status = "Closed.";

    private void CloseFirst()
    {
        _first = false;
        _status = "Closed; focus returned to the button that opened it.";
    }

    private const string Usage = """
        <ModalSheet Show="@_open" Title="Edit item" OnClose="() => _open = false">
            <input autofocus />   @* [autofocus] gets focus first *@
            ...
        </ModalSheet>

        @* Custom header: give the dialog an accessible name yourself *@
        <ModalSheet Show="@_open" AriaLabel="Exercise video" OnClose="Close">
            <HeaderContent><h3>Squat</h3></HeaderContent>
            <ChildContent>...</ChildContent>
        </ModalSheet>
        """;

    private const string CssExample = """
        :root { --bob-modal-max-width: 40rem; --bob-modal-backdrop: rgb(10 10 40 / 0.6); }
        .bob-modal[data-bob-part="sheet"] { border-top: 4px solid tomato; }
        """;

    private static readonly DocParam[] _params =
    [
        new("Show", "bool", "false", "Whether the sheet is open. The caller owns this state and clears it in OnClose."),
        new("Title", "string?", "null", "Heading text and the dialog's accessible name."),
        new("AriaLabel", "string?", "null", "Accessible name when you use HeaderContent and no Title."),
        new("OnClose", "EventCallback", "none", "Called for the close button, the backdrop, Escape and the browser back button."),
        new("EnableBackButton", "bool", "true", "Close on the browser or Android back button instead of leaving the page."),
        new("ShowHandle", "bool", "false", "Show the drag-handle pill at the top."),
        new("SheetClass", "string?", "null", "Extra classes on the sheet element."),
        new("HeaderContent", "RenderFragment?", "null", "Replaces the default title and close button."),
        new("ChildContent", "RenderFragment?", "null", "The sheet body."),
    ];

    private static readonly DocPart[] _parts =
    [
        new("backdrop", "bob-modal-backdrop", "Full-screen overlay; clicking it closes the sheet"),
        new("sheet", "bob-modal", "div, role=dialog, aria-modal"),
        new("handle", "bob-modal__handle", "Optional drag pill (ShowHandle)"),
        new("header", "bob-modal__header", "Title row"),
        new("title", "bob-modal__title", "h3 with the Title"),
        new("close", "bob-modal__close", "Close button, aria-label=Close"),
        new("body", "bob-modal__body", "Wraps ChildContent"),
    ];

    private static readonly DocVar[] _vars =
    [
        new("--bob-modal-z", "var(--bob-z-modal)", "Stacking order"),
        new("--bob-modal-backdrop", "rgb(0 0 0 / 0.5)", "Overlay color"),
        new("--bob-modal-bg", "var(--bob-color-surface)", "Sheet background"),
        new("--bob-modal-border", "var(--bob-color-border)", "Sheet border color"),
        new("--bob-modal-radius", "1.25rem 1.25rem 0 0; var(--bob-radius-lg) from 640px", "Corner radius"),
        new("--bob-modal-max-width", "26rem", "Maximum sheet width"),
        new("--bob-modal-max-height", "88vh", "Maximum sheet height"),
        new("--bob-modal-padding", "0.9rem 1rem 1.1rem", "Inner spacing"),
        new("--bob-modal-shadow", "var(--bob-shadow)", "Drop shadow"),
    ];

    private static readonly string[] _a11y =
    [
        "role=\"dialog\" with aria-modal=\"true\" and an accessible name from Title or AriaLabel (WCAG 4.1.2).",
        "Focus moves into the dialog on open, Tab and Shift+Tab are trapped inside it by js/focusTrap.js, and focus returns to whatever opened it on close (2.4.3). aria-modal alone does not stop real keyboard focus leaving a dialog.",
        "A field marked autofocus is focused first; otherwise the first focusable element in the header.",
        "Escape closes. Stacked sheets each keep their own trap and previously-focused element; only the top one reacts to Tab.",
        "The browser or Android back button closes the sheet instead of leaving the page (js/modalHistory.js).",
        "The close button is at least 44x44px and has aria-label=\"Close\"; its icon is aria-hidden.",
    ];

    private static readonly DocError[] _errors =
    [
        new("BOB-PARAM-002", "when the sheet is open with neither Title nor AriaLabel."),
        new("BOB-ASSET-001", "when js/focusTrap.js or js/modalHistory.js cannot be loaded; the message names the path."),
        new("BOB-CB-001", "when your OnClose handler throws."),
    ];
}
