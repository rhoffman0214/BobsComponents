@inherits BobComponentBase
@implements IAsyncDisposable
@attribute [BobRequiresService(typeof(IJSRuntime))]
@inject IJSRuntime JS
@attribute [System.ComponentModel.Description("Backdrop, sheet and header for dialogs: a bottom sheet on phones, a centered dialog from 640px. Owns focus trapping and the browser back button.")]

@* Backdrop + sheet + header scaffold for dialogs. Owns focus trapping (focusTrap.js) and the Android/browser
   back-button integration (modalHistory.js), so every caller gets both. *@
@if (Show)
{
    <div class="bob-modal-backdrop" data-bob-part="backdrop" @onclick="RequestClose">
        <div class="bob-modal @SheetClass" data-bob-part="sheet" @ref="_sheetRef" @onclick:stopPropagation="true"
             @onkeydown="OnKeyDown" role="dialog" aria-modal="true" aria-label="@AccessibleName" tabindex="-1">
            @if (ShowHandle)
            {
                <div class="bob-modal__handle" data-bob-part="handle" aria-hidden="true"></div>
            }
            <div class="bob-modal__header" data-bob-part="header">
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else
                {
                    <h3 class="bob-modal__title" data-bob-part="title">@Title</h3>
                    <button type="button" class="bob-modal__close" data-bob-part="close" aria-label="Close" @onclick="RequestClose">
                        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <path d="M5 5l14 14M19 5L5 19" />
                        </svg>
                    </button>
                }
            </div>
            <div class="bob-modal__body" data-bob-part="body">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Whether the sheet is open. The caller owns this state and clears it in <see cref="OnClose"/>.</summary>
    [Parameter] public bool Show { get; set; }

    /// <summary>Heading text, also the dialog's accessible name.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Accessible name when you supply <see cref="HeaderContent"/> and no <see cref="Title"/>.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Called for the close button, the backdrop, Escape and the browser back button.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Close on the browser/Android back button instead of leaving the page. Default true.</summary>
    [Parameter] public bool EnableBackButton { get; set; } = true;

    /// <summary>Show the drag-handle pill at the top.</summary>
    [Parameter] public bool ShowHandle { get; set; }

    /// <summary>Extra classes on the sheet element.</summary>
    [Parameter] public string? SheetClass { get; set; }

    /// <summary>Replaces the default title and close button.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>The sheet body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? AccessibleName => Title ?? AriaLabel;

    private IJSObjectReference? modalHistoryModule;
    private IJSObjectReference? focusTrapModule;
    private DotNetObjectReference<ModalSheet>? selfRef;
    private ElementReference _sheetRef;
    private bool wasShown;
    private bool skipHistoryPop;
    private bool focusTrapped;

    protected override void ValidateParameters(BobParameterValidator check)
    {
        if (Show)
            check.Must(nameof(Title), !string.IsNullOrWhiteSpace(AccessibleName), Title,
                "Title, or AriaLabel when HeaderContent is used, so the dialog has an accessible name");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Separate from the Show/wasShown tracking in OnParametersSetAsync: that runs before the sheet's markup
        // exists, and trapping needs the element reference, which only exists after a render.
        if (Show && !focusTrapped)
        {
            focusTrapped = true;
            try
            {
                focusTrapModule ??= await BobJs.ImportAsync(JS, nameof(ModalSheet), BobJs.FocusTrap);
                await BobJs.CallAsync(focusTrapModule, nameof(ModalSheet), BobJs.FocusTrap, "trap", _sheetRef);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException)
            {
                // Navigated away before the import/trap round-trip finished.
            }
        }
        else if (!Show && focusTrapped)
        {
            focusTrapped = false;
            if (focusTrapModule is not null)
            {
                try { await BobJs.CallAsync(focusTrapModule, nameof(ModalSheet), BobJs.FocusTrap, "release"); }
                catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
            }
        }
    }

    private Task OnKeyDown(KeyboardEventArgs e) =>
        e.Key == "Escape" ? RequestClose() : Task.CompletedTask;

    protected override async Task OnParametersSetAsync()
    {
        if (!EnableBackButton)
        {
            wasShown = Show;
            return;
        }

        if (Show && !wasShown)
        {
            selfRef ??= DotNetObjectReference.Create(this);
            modalHistoryModule ??= await BobJs.ImportAsync(JS, nameof(ModalSheet), BobJs.ModalHistory);
            try { await BobJs.CallAsync(modalHistoryModule, nameof(ModalSheet), BobJs.ModalHistory, "openModal", selfRef); }
            catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
        }
        else if (!Show && wasShown)
        {
            if (skipHistoryPop)
            {
                // The back-button path already popped this entry itself; popping again would go back an extra page.
                skipHistoryPop = false;
            }
            else if (modalHistoryModule is not null)
            {
                try { await BobJs.CallAsync(modalHistoryModule, nameof(ModalSheet), BobJs.ModalHistory, "closeModal"); }
                catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
            }
        }

        wasShown = Show;
    }

    private Task RequestClose() => InvokeCallbackAsync(nameof(OnClose), OnClose);

    /// <summary>Called from modalHistory.js when the back gesture pops the entry this sheet pushed.</summary>
    [JSInvokable]
    public async Task OnModalBackButton()
    {
        skipHistoryPop = true;
        await InvokeAsync(RequestClose);
    }

    public async ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        if (modalHistoryModule is not null)
        {
            try { await modalHistoryModule.DisposeAsync(); }
            catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
        }

        if (focusTrapModule is not null)
        {
            try
            {
                // Navigating away while open skips the Show-flips-false branch, so release the trap here too
                // or its keydown listener and stack entry leak past this component's life.
                if (focusTrapped) await focusTrapModule.InvokeVoidAsync("release");
                await focusTrapModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
        }
    }
}
