@inherits BobComponentBase
@implements IDisposable
@attribute [BobRequiresService(typeof(IBobToastService))]

@* Mount once in the layout. Subscribes to IBobToastService; any component can call Show(...) without a reference to this one. *@
<div class="bob-toast-host" aria-live="polite" data-bob-part="host">
    @foreach (var toast in _toasts)
    {
        <div class="bob-toast bob-toast--@toast.Level.ToString().ToLowerInvariant()" data-bob-part="toast"
             role="@(toast.Level == BobToastLevel.Error ? "alert" : null)" @key="toast.Id">
            <svg class="bob-toast__icon" data-bob-part="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                @switch (toast.Level)
                {
                    case BobToastLevel.Success:
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.5 14.5-4-4 1.4-1.4 2.6 2.6 5.6-5.6 1.4 1.4-7 7Z" />
                        break;
                    case BobToastLevel.Error:
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z" />
                        break;
                    default:
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-6h2v6Zm0-8h-2V7h2v2Z" />
                        break;
                }
            </svg>
            <span class="bob-toast__text" data-bob-part="text">@toast.Text</span>
        </div>
    }
</div>

@code {
    private readonly List<BobToast> _toasts = [];
    private readonly CancellationTokenSource _disposed = new();
    private IBobToastService? _service;

    /// <summary>Replaces the toast service from DI; mainly for tests and multiple hosts.</summary>
    [Parameter] public IBobToastService? Service { get; set; }

    protected override void OnInitialized()
    {
        _service = Service ?? RequireService<IBobToastService>();
        _service.OnShow += HandleShow;
    }

    private void HandleShow(BobToast toast) => _ = InvokeAsync(() => ShowAsync(toast));

    private async Task ShowAsync(BobToast toast)
    {
        _toasts.Add(toast);
        while (_toasts.Count > Math.Max(1, BobOptions.Toasts.MaxVisible)) _toasts.RemoveAt(0);
        StateHasChanged();

        try
        {
            await Task.Delay(toast.Duration ?? BobOptions.Toasts.DefaultDuration, _disposed.Token);
        }
        catch (OperationCanceledException)
        {
            return; // Host torn down during the delay.
        }

        if (_toasts.Remove(toast)) StateHasChanged();
    }

    public void Dispose()
    {
        _disposed.Cancel();
        if (_service is not null) _service.OnShow -= HandleShow;
    }
}
