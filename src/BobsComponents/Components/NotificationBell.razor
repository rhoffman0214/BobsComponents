@inherits BobComponentBase
@using BobsComponents.Services
@attribute [System.ComponentModel.Description("A bell button with an unread badge that opens a panel of notifications. Data comes from an IBobNotificationSource (the Source parameter or a registered service); opening the panel loads the list and marks everything read.")]

@* The unread count loads once on first render and again whenever the app calls RefreshAsync (for example after
   navigation); there is no polling. A failed load keeps the last known state and reports the error. *@
<div class="bob-notification-bell @CssClass" data-bob-part="root" @attributes="AdditionalAttributes">
    <button type="button" class="bob-notification-bell__button" data-bob-part="button"
            aria-expanded="@(_open ? "true" : "false")" aria-controls="@_panelId"
            aria-label="@(_unread > 0 ? $"{Label}, {_unread} unread" : Label)"
            @onclick="ToggleAsync" @ref="_buttonRef">
        <span class="bob-notification-bell__icon" data-bob-part="icon" aria-hidden="true">&#128276;</span>
        @if (_unread > 0)
        {
            <span class="bob-notification-bell__badge" data-bob-part="badge" aria-hidden="true">@(_unread > 9 ? "9+" : _unread.ToString())</span>
        }
    </button>
    @if (_open)
    {
        <div class="bob-notification-bell__backdrop" data-bob-part="backdrop" aria-hidden="true" @onclick="Close"></div>
        <div class="bob-notification-bell__panel" data-bob-part="panel" id="@_panelId" role="region" aria-label="@Label" @onkeydown="OnKeyDown">
            @if (_loading)
            {
                <p class="bob-notification-bell__status" data-bob-part="status" role="status">@LoadingText</p>
            }
            else if (_items.Count == 0)
            {
                <p class="bob-notification-bell__status" data-bob-part="status">@EmptyText</p>
            }
            else
            {
                <ul class="bob-notification-bell__list" data-bob-part="list">
                    @foreach (var n in _items)
                    {
                        var item = n;
                        <li class="bob-notification-bell__item" data-bob-part="item">
                            @if (!string.IsNullOrEmpty(item.LinkUrl))
                            {
                                <button type="button" class="bob-notification-bell__link" data-bob-part="link" @onclick="() => OpenAsync(item)">
                                    <span class="bob-notification-bell__message">@item.Message</span>
                                    <span class="bob-notification-bell__time">@Relative(item.At)</span>
                                </button>
                            }
                            else
                            {
                                <span class="bob-notification-bell__message">@item.Message</span>
                                <span class="bob-notification-bell__time">@Relative(item.At)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    private static int _nextId;

    /// <summary>The data source. When null, a registered <see cref="IBobNotificationSource"/> service is used.</summary>
    [Parameter] public IBobNotificationSource? Source { get; set; }

    /// <summary>Accessible name of the button and the panel.</summary>
    [Parameter] public string Label { get; set; } = "Notifications";

    /// <summary>Shown while the list loads.</summary>
    [Parameter] public string LoadingText { get; set; } = "Loading...";

    /// <summary>Shown when there are no notifications.</summary>
    [Parameter] public string EmptyText { get; set; } = "Nothing yet.";

    /// <summary>Raised with the entry's LinkUrl when a linked entry is activated. The panel closes first.</summary>
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    /// <summary>Extra classes on the root element.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Any other attribute is placed on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _panelId = $"bob-notification-bell-{Interlocked.Increment(ref _nextId)}";
    private IReadOnlyList<BobNotification> _items = [];
    private ElementReference _buttonRef;
    private bool _open;
    private bool _loading;
    private int _unread;

    private IBobNotificationSource Data => Source ?? RequireService<IBobNotificationSource>();
    private TimeProvider Clock => OptionalService<TimeProvider>() ?? TimeProvider.System;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    /// <summary>Reloads the unread count. Call it after navigation or when the app knows something arrived.</summary>
    public async Task RefreshAsync()
    {
        if (_open) return; // the open panel is current and has just marked everything read
        try
        {
            _unread = await Data.GetUnreadCountAsync();
        }
        catch (Exception ex) when (ex is not BobException)
        {
            ReportError(ex);
        }
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        _open = !_open;
        if (!_open) return;
        _loading = true;
        try
        {
            _items = await Data.ListAsync();
            if (_unread > 0)
            {
                await Data.MarkAllReadAsync();
                _unread = 0;
            }
        }
        catch (Exception ex) when (ex is not BobException)
        {
            _items = [];
            ReportError(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Close() => _open = false;

    private async Task OpenAsync(BobNotification item)
    {
        Close();
        await InvokeCallbackAsync(nameof(OnNavigate), OnNavigate, item.LinkUrl!);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        Close();
        await _buttonRef.FocusAsync();
    }

    private string Relative(DateTimeOffset at)
    {
        var span = Clock.GetUtcNow() - at;
        if (span < TimeSpan.FromMinutes(1)) return "just now";
        if (span < TimeSpan.FromHours(1)) return $"{(int)span.TotalMinutes}m ago";
        if (span < TimeSpan.FromDays(1)) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }
}
